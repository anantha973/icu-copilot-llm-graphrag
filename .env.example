# ICU Clinical Copilot — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit the real .env to git

# HuggingFace token (required for MedGemma 4B download)
HF_TOKEN=your_huggingface_token_here

# Model paths (optional override — defaults to models/ directory)
# MEDGEMMA_PATH=models/medgemma-4b-q4_k_m.gguf
# GEMMA4_PATH=models/gemma4-e4b-uncensored-q4_k_m.gguf

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
